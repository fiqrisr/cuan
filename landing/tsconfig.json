{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "outDir": "../.moon/cache/types/landing",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@cuan/ui": [
        "../packages/ui/src/index.ts"
      ],
      "@cuan/ui/*": [
        "../packages/ui/src/*"
      ]
    }
  },
  "references": [
    {
      "path": "../packages/ui"
    }
  ]
}
