---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from "@vercel/speed-insights/astro"
import '@/styles/global.css';
import { landingTranslations, type Locale } from '@/i18n/translations';

type Props = {
  title: string;
  description: string;
  locale?: Locale;
};

const { title, description, locale = 'id' } = Astro.props;
const t = landingTranslations[locale];
const APP_URL = 'https://app.cuan.fiqri.dev';
const canonical = new URL(Astro.url.pathname, Astro.site);

const isEn = locale === 'en';
const homeHref = isEn ? '/en/' : '/';
const altLocaleHref = isEn ? '/' : '/en/';
const privacyHref = isEn ? '/en/privacy/' : '/privacy/';
const termsHref = isEn ? '/en/terms/' : '/terms/';
---

<!doctype html>
<html lang={locale} class="grain">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cuan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cuan - Your personal AI financial assistant" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />

    {!isEn && (
      <script is:inline>
        // If user already preferred English or browser is English (and no manual override), redirect to /en/
        try {
          const stored = localStorage.getItem('cuan-locale');
          if (stored === 'en' && window.location.pathname === '/') {
            window.location.replace('/en/');
          }
        } catch {}
      </script>
    )}
    <Analytics />
    <SpeedInsights />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">{isEn ? 'Skip to content' : 'Lewati ke konten'}</a>

    <header class="fixed inset-x-0 top-0 z-50 border-b border-border/10 bg-background/40 backdrop-blur-lg">
      <nav
        class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5 sm:px-6"
        aria-label="Primary"
      >
        <a href={homeHref} class="flex items-center gap-3" aria-label="Cuan home">
          <span
            class="glass-panel flex h-9 w-9 items-center justify-center rounded-xl border-primary/20 text-primary shadow-tint"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 8V4H8" />
              <rect width="16" height="12" x="4" y="8" rx="2" />
              <path d="M2 14h2" />
              <path d="M20 14h2" />
              <path d="M15 13v2" />
              <path d="M9 13v2" />
            </svg>
          </span>
          <span class="leading-tight">
            <span class="block text-sm font-semibold text-foreground">Cuan</span>
            <span class="mt-0.5 block text-[11px] font-medium text-muted-foreground">
              {t.chatPreview.botSubtitle}
            </span>
          </span>
        </a>
        <div class="flex items-center gap-4 sm:gap-6">
          <a
            href="#features"
            class="body-md hidden text-muted-foreground transition-colors hover:text-foreground sm:block"
          >
            {t.nav.features}
          </a>
          <a
            href="#how-it-works"
            class="body-md hidden text-muted-foreground transition-colors hover:text-foreground sm:block"
          >
            {t.nav.howItWorks}
          </a>

          <!-- Language Switcher -->
          <a
            href={altLocaleHref}
            class="data-mono rounded-md border border-border/20 bg-muted/20 px-2 py-1 text-xs text-muted-foreground transition-colors hover:border-primary/30 hover:text-foreground"
            title={`Switch to ${isEn ? 'Bahasa Indonesia' : 'English'}`}
            onclick={`try { localStorage.setItem('cuan-locale', '${isEn ? 'id' : 'en'}'); } catch {}`}
          >
            {isEn ? 'ID' : 'EN'}
          </a>

          <a
            href={APP_URL}
            class="label-caps rounded-md bg-primary px-4 py-2 text-primary-foreground transition-transform active:scale-[0.98]"
          >
            {t.nav.openApp}
          </a>
        </div>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border/10 bg-background/50">
      <div
        class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 px-5 py-6 text-xs text-muted-foreground sm:flex-row sm:px-6"
      >
        <p>&copy; {new Date().getFullYear()} Cuan</p>
        <div class="flex items-center gap-5">
          <a href={privacyHref} class="transition-colors hover:text-foreground">{t.nav.privacy}</a>
          <a href={termsHref} class="transition-colors hover:text-foreground">{t.nav.terms}</a>
          <a href={APP_URL} class="transition-colors hover:text-foreground">{t.nav.signIn}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
