---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from "@vercel/speed-insights/astro"
import '@/styles/global.css';
import { landingTranslations, type Locale } from '@/i18n/translations';

type Props = {
  title: string;
  description: string;
  locale?: Locale;
};

const { title, description, locale = 'id' } = Astro.props;
const t = landingTranslations[locale];
const APP_URL = 'https://app.cuan.fiqri.dev';
const canonical = new URL(Astro.url.pathname, Astro.site);

const isEn = locale === 'en';
const homeHref = isEn ? '/en/' : '/';
const altLocaleHref = isEn ? '/' : '/en/';
const privacyHref = isEn ? '/en/privacy/' : '/privacy/';
const termsHref = isEn ? '/en/terms/' : '/terms/';
---

<!doctype html>
<html lang={locale} class="grain">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cuan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cuan - Your personal AI financial assistant" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Theme initialization: prevent FOUC and sync with cuan-theme
      (function () {
        try {
          const theme = localStorage.getItem('cuan-theme');
          const isDark =
            theme === 'dark' ||
            (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches) ||
            (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          const root = document.documentElement;
          if (isDark) {
            root.classList.remove('light');
            root.classList.add('dark');
            root.style.colorScheme = 'dark';
          } else {
            root.classList.remove('dark');
            root.classList.add('light');
            root.style.colorScheme = 'light';
          }
        } catch {}
      })();
    </script>
    {!isEn && (
      <script is:inline>
        // If user already preferred English or browser is English (and no manual override), redirect to /en/
        try {
          const stored = localStorage.getItem('cuan-locale');
          if (stored === 'en' && window.location.pathname === '/') {
            window.location.replace('/en/');
          }
        } catch {}
      </script>
    )}
    <Analytics />
    <SpeedInsights />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">{isEn ? 'Skip to content' : 'Lewati ke konten'}</a>

    <header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 sm:pt-6 pointer-events-none">
      <nav
        class="pointer-events-auto mx-auto flex h-14 max-w-4xl items-center justify-between px-4 sm:px-6 rounded-full border border-border bg-card/85 backdrop-blur-xl shadow-lg card-inner-highlight transition-all"
        aria-label="Primary"
      >
        <a href={homeHref} class="flex items-center gap-2.5" aria-label="Cuan home">
          <img src="/favicon.svg" alt="" width="28" height="28" class="h-7 w-7 rounded-lg shrink-0" />
          <span class="leading-tight">
            <span class="block text-sm font-semibold text-foreground">Cuan</span>
          </span>
        </a>
        <div class="flex items-center gap-3 sm:gap-6">
          <a
            href="#features"
            class="text-xs sm:text-sm font-medium text-muted-foreground transition-colors hover:text-foreground hidden sm:block"
          >
            {t.nav.features}
          </a>
          <a
            href="#how-it-works"
            class="text-xs sm:text-sm font-medium text-muted-foreground transition-colors hover:text-foreground hidden sm:block"
          >
            {t.nav.howItWorks}
          </a>

          <!-- Language Switcher -->
          <a
            href={altLocaleHref}
            class="data-mono rounded-full border border-border bg-muted/60 px-2.5 py-1 text-xs font-medium text-muted-foreground transition-colors hover:border-primary/40 hover:text-foreground"
            title={`Switch to ${isEn ? 'Bahasa Indonesia' : 'English'}`}
            onclick={`try { localStorage.setItem('cuan-locale', '${isEn ? 'id' : 'en'}'); } catch {}`}
          >
            {isEn ? 'ID' : 'EN'}
          </a>

          <!-- Theme Switcher -->
          <button
            type="button"
            id="landing-theme-toggle"
            class="flex h-8 w-8 items-center justify-center rounded-full border border-border bg-muted/60 text-muted-foreground transition-colors hover:border-primary/40 hover:text-foreground cursor-pointer active:scale-95"
            title="Toggle light / dark theme"
            aria-label="Toggle theme"
          >
            <svg id="theme-sun-icon" class="hidden h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
            </svg>
            <svg id="theme-moon-icon" class="hidden h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            </svg>
          </button>
          <a
            href={APP_URL}
            class="label-caps rounded-full bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground transition-all hover:bg-primary/90 shadow-sm active:scale-[0.98]"
          >
            {t.nav.openApp}
          </a>
        </div>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border bg-card/30">
      <div
        class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 px-5 py-6 text-xs text-muted-foreground sm:flex-row sm:px-6"
      >
        <p>&copy; {new Date().getFullYear()} Cuan</p>
        <div class="flex items-center gap-5">
          <a href={privacyHref} class="transition-colors hover:text-foreground">{t.nav.privacy}</a>
          <a href={termsHref} class="transition-colors hover:text-foreground">{t.nav.terms}</a>
          <a href={APP_URL} class="transition-colors hover:text-foreground">{t.nav.signIn}</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        const toggle = document.getElementById('landing-theme-toggle');
        const sun = document.getElementById('theme-sun-icon');
        const moon = document.getElementById('theme-moon-icon');

        function syncIcons() {
          const isDark = document.documentElement.classList.contains('dark') || !document.documentElement.classList.contains('light');
          if (isDark) {
            sun?.classList.remove('hidden');
            moon?.classList.add('hidden');
          } else {
            sun?.classList.add('hidden');
            moon?.classList.remove('hidden');
          }
        }

        syncIcons();

        toggle?.addEventListener('click', () => {
          const isDark = document.documentElement.classList.contains('dark') || !document.documentElement.classList.contains('light');
          const nextTheme = isDark ? 'light' : 'dark';
          const root = document.documentElement;

          if (nextTheme === 'dark') {
            root.classList.remove('light');
            root.classList.add('dark');
            root.style.colorScheme = 'dark';
          } else {
            root.classList.remove('dark');
            root.classList.add('light');
            root.style.colorScheme = 'light';
          }

          try {
            localStorage.setItem('cuan-theme', nextTheme);
          } catch {}
          syncIcons();
        });
      })();
    </script>
  </body>
</html>
