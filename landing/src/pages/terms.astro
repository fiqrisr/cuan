---
import Base from '@/layouts/Base.astro';
import { landingTranslations } from '@/i18n/translations';

const t = landingTranslations.id.terms;
---

<Base
  title={`${t.title} - Cuan`}
  description={t.intro}
  locale="id"
>
  <section class="mx-auto max-w-3xl px-5 pt-32 pb-24 sm:px-6 sm:pt-40">
    <h1 class="headline-md text-foreground">{t.title}</h1>
    <p class="body-md mt-2 text-muted-foreground">{t.updated}</p>

    <div class="body-lg mt-10 flex flex-col gap-6 text-muted-foreground">
      <p>{t.intro}</p>

      {
        t.sections.map((s) => (
          <div>
            <h2 class="headline-sm pt-4 text-foreground">{s.title}</h2>
            <p class="mt-2">{s.body}</p>
          </div>
        ))
      }
    </div>
  </section>
</Base>
