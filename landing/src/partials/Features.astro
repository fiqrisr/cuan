---
import { landingTranslations, type Locale } from '@/i18n/translations';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = landingTranslations[locale];
---

<section id="features" class="border-t border-border bg-card/25">
  <div class="mx-auto max-w-5xl px-5 py-24 sm:px-6 sm:py-32">
    <div class="flex flex-col gap-2">
      <span class="label-caps text-primary tracking-widest font-semibold uppercase text-xs">Capabilities</span>
      <h2 class="headline-md max-w-2xl text-foreground">
        {t.features.heading}
      </h2>
    </div>
    <div class="mt-16 grid gap-6 sm:grid-cols-2">
      {
        t.features.items.map((f, idx) => (
          <article
            class="group relative rounded-2xl border border-border bg-card p-6 sm:p-8 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-border-strong hover:shadow-md card-inner-highlight"
          >
            <div class="flex items-center justify-between mb-4">
              <span class="data-mono text-xs font-semibold text-muted-foreground/60">0{idx + 1}</span>
              <div class="w-2 h-2 rounded-full bg-primary/40 group-hover:bg-primary transition-colors" />
            </div>
            <h3 class="headline-sm text-foreground">{f.title}</h3>
            <p class="body-md mt-3 text-muted-foreground leading-relaxed">{f.body}</p>
            {'stat' in f && f.stat && (
              <div class="mt-6 border-t border-border pt-5">
                <p class="data-mono text-2xl font-semibold text-primary">{f.stat}</p>
                <p class="label-caps mt-1 text-muted-foreground">{f.statLabel}</p>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
