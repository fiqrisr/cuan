PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cuan
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
LOG_LEVEL=info

# AI provider: openmodel | gemini
AI_PROVIDER=openmodel

# OpenModel provider settings (required when AI_PROVIDER=openmodel)
OPENMODEL_API_KEY=your-openmodel-api-key
OPENMODEL_BASE_URL=https://api.openmodel.ai
OPENMODEL_MODEL=gpt-4o

# Gemini provider settings (required when AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

NODE_ENV=development
