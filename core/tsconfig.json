{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "tsconfig-moon/tsconfig.projects.json",
  "include": [
    "worker-configuration.d.ts",
    "src/**/*",
    "tests/**/*",
    "scripts/**/*",
    "drizzle.config.ts"
  ],
  "compilerOptions": {
    "outDir": "../.moon/cache/types/core",
    "baseUrl": ".",
    "skipLibCheck": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["src/*"],
      "@cuan/elysia-logger": ["../packages/elysia-logger/src/index.ts"],
      "@cuan/elysia-logger/*": ["../packages/elysia-logger/src/*"],
      "@cuan/elysia-rate-limiter": ["../packages/elysia-rate-limiter/src/index.ts"],
      "@cuan/elysia-rate-limiter/*": ["../packages/elysia-rate-limiter/src/*"]
    },
    "types": ["./worker-configuration.d.ts"]
  },
  "references": [
    {
      "path": "../packages/elysia-logger"
    },
    {
      "path": "../packages/elysia-rate-limiter"
    }
  ]
}
