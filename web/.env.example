# The URL of the Cuan API (core)
# In development, leave this empty to use the Vite proxy to localhost:8787
# In production, set this to the public URL of the backend (e.g., https://api.yourdomain.com)
VITE_API_URL=

# The domain or URL of the landing/marketing site (used for privacy, terms, etc.)
# Defaults to https://cuan.fiqri.dev if not set
VITE_LANDING_URL=https://cuan.fiqri.dev

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
