{
  "name": "@cuan/root",
  "version": "0.1.0",
  "private": true,
  "description": "Cuan monorepo root",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "core",
    "web",
    "landing",
    "packages/ui",
    "packages/elysia-logger",
    "packages/elysia-rate-limiter"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "release": "bun run scripts/release.ts",
    "release:dry": "bun run scripts/release.ts --dry-run",
    "release:patch": "bun run scripts/release.ts --patch",
    "release:minor": "bun run scripts/release.ts --minor",
    "release:major": "bun run scripts/release.ts --major"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.2",
    "tsconfig-moon": "^1.4.2",
    "typescript": "^5.7.2"
  }
}
